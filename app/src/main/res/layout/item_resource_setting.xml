<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="4dp"
    android:paddingHorizontal="4dp"
    android:layout_marginStart="36dp">

    <ImageView
        android:id="@+id/ivResourceIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="Resource Icon"
        android:src="@drawable/ic_item_tree" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvResourceName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wood"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvResourceSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="چوب (درخت)"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchResource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@color/switch_thumb_selector"
        app:trackTint="@color/switch_track_selector" />
</LinearLayout>
